    },
    "GachaTip8" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도망칠 길 따윈 필요 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需退路。"
          }
        }
      }
    },
    "GachaTip9" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영웅들이여, 이 흔들리지 않는 신념을 기리어, 우리와 함께하라."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英雄们啊，为这最强大的信念，请站在我们这边。"
          }
        }
      }
    },
    "GachaTip10" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벌벌 떨어라. 진정한 용맹함 앞에서."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颤抖吧，在真正的勇敢面前。"
